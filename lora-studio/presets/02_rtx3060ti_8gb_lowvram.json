{
  "name": "VRAM 8GB 省メモリ（OOM が出る場合）",
  "description": "標準設定に fp8_base（ベースモデルを FP8 で保持）と full_bf16 を追加。目安: 約 5〜6GB 使用。ブラウザ等と同時に使う場合や、標準で Out of Memory になる場合に。",
  "config": {
    "num_repeats": 10,
    "resolution": 1024,
    "enable_bucket": true,
    "min_bucket_reso": 512,
    "max_bucket_reso": 2048,
    "shuffle_caption": false,
    "keep_tokens": 1,
    "batch_size": 1,
    "max_train_epochs": 10,
    "save_every_n_epochs": 2,
    "network_dim": 16,
    "network_alpha": 8,
    "unet_lr": 0.0001,
    "text_encoder_lr": 0.00001,
    "network_train_unet_only": true,
    "optimizer_type": "AdamW8bit",
    "lr_scheduler": "cosine",
    "lr_warmup_steps": 0,
    "noise_offset": 0.0,
    "min_snr_gamma": 5.0,
    "seed": 42,
    "mixed_precision": "bf16",
    "save_precision": "fp16",
    "full_bf16": true,
    "fp8_base": true,
    "gradient_checkpointing": true,
    "cache_latents": true,
    "cache_latents_to_disk": true,
    "cache_text_encoder_outputs": true,
    "attention": "sdpa",
    "max_data_loader_n_workers": 0
  }
}
