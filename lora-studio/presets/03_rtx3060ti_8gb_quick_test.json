{
  "name": "VRAM 8GB お試し（短時間・768px）",
  "description": "動作確認用。768px・少ないエポック数で素早く完了します。本番前に環境が正しく動くか確かめるのに使ってください。",
  "config": {
    "num_repeats": 5,
    "resolution": 768,
    "enable_bucket": true,
    "min_bucket_reso": 384,
    "max_bucket_reso": 1536,
    "shuffle_caption": false,
    "keep_tokens": 1,
    "batch_size": 1,
    "max_train_epochs": 4,
    "save_every_n_epochs": 2,
    "network_dim": 8,
    "network_alpha": 4,
    "unet_lr": 0.0002,
    "text_encoder_lr": 0.00001,
    "network_train_unet_only": true,
    "optimizer_type": "AdamW8bit",
    "lr_scheduler": "constant",
    "lr_warmup_steps": 0,
    "noise_offset": 0.0,
    "min_snr_gamma": 5.0,
    "seed": 42,
    "mixed_precision": "bf16",
    "save_precision": "fp16",
    "full_bf16": false,
    "fp8_base": false,
    "gradient_checkpointing": true,
    "cache_latents": true,
    "cache_latents_to_disk": true,
    "cache_text_encoder_outputs": true,
    "attention": "sdpa",
    "max_data_loader_n_workers": 1
  }
}
